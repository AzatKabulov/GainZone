{
  "expo": {
    "name": "GainZone",
    "slug": "gainzone",
    "scheme": "gainzone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0B",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gainzone.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.gainzone.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0B"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      "expo-image",
      "expo-sharing",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "owner": "azatkabulov",
    "extra": {
      "eas": {
        "projectId": "10b59227-b7c4-433a-a8a9-95a95e3cc525"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/10b59227-b7c4-433a-a8a9-95a95e3cc525"
    }
  }
}
